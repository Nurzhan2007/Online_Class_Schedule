# Copy this file to .env (in the backend folder) and adjust the values.

# REQUIRED. The server refuses to start without it (minimum 32 characters).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# How long a login stays valid (minutes). Matches the old 30-minute session.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Account lockout: after this many consecutive wrong passwords
# the account is locked for LOCKOUT_MINUTES.
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_MINUTES=5

# Leave empty to use backend/kbtu.db
DATABASE_URL=

# Only needed if you open the frontend from another server (e.g. VS Code Live Server).
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
